[gd_scene load_steps=7 format=3 uid="uid://citysc4pe0001"]

[sub_resource type="Shader" id="city_facade"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 frame_color : source_color = vec3(0.14, 0.17, 0.21);
uniform vec3 glass_color : source_color = vec3(0.42, 0.57, 0.72);
uniform vec3 lit_color : source_color = vec3(1.0, 0.93, 0.72);
uniform float columns : hint_range(2.0, 40.0) = 7.0;
uniform float rows : hint_range(2.0, 60.0) = 14.0;
uniform float glass_ratio : hint_range(0.1, 0.95) = 0.78;
uniform float lit_chance : hint_range(0.0, 1.0) = 0.35;
uniform float lit_strength : hint_range(0.0, 8.0) = 3.0;

void fragment() {
	vec2 cell = floor(UV * vec2(columns, rows));
	vec2 f = fract(UV * vec2(columns, rows)) - vec2(0.5);
	float is_window = step(max(abs(f.x), abs(f.y)), glass_ratio * 0.5);
	float rnd = fract(sin(dot(cell, vec2(127.1, 311.7))) * 43758.5453);
	float lit = step(1.0 - lit_chance, rnd);
	vec3 window_col = mix(glass_color, lit_color, lit * 0.75);
	ALBEDO = mix(frame_color, window_col, is_window);
	EMISSION = is_window * lit * lit_color * lit_strength;
	ROUGHNESS = mix(0.6, 0.15, is_window);
	METALLIC = 0.0;
}"

