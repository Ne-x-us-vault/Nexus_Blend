[gd_scene load_steps=7 format=3 uid="uid://citysc4pe0001"]

[sub_resource type="Shader" id="city_facade"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 frame_color : source_color = vec3(0.14, 0.17, 0.21);
uniform vec3 glass_color : source_color = vec3(0.42, 0.57, 0.72);
uniform vec3 lit_color : source_color = vec3(1.0, 0.93, 0.72);

uniform float window_width : hint_range(0.1, 5.0) = 1.2;
uniform float window_height : hint_range(0.1, 5.0) = 2.0;
uniform float spacing_x : hint_range(0.05, 2.0) = 0.4;
uniform float spacing_y : hint_range(0.05, 2.0) = 0.6;
uniform float lit_chance : hint_range(0.0, 1.0) = 0.35;
uniform float lit_strength : hint_range(0.0, 8.0) = 3.0;

// Window grid is computed in world space so windows stay the exact same
// physical size on every building, no matter how tall or wide the mesh is.
varying vec3 world_pos;
varying vec3 world_normal;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_normal = (MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz;
}

void fragment() {
	vec3 albedo = frame_color;
	float rough = 0.8;
	float metal = 0.0;
	vec3 emission = vec3(0.0);

	vec3 n = abs(world_normal);
	if (n.x > 0.5 || n.z > 0.5) {
		vec2 pos_2d = n.x > 0.5 ? vec2(world_pos.z, world_pos.y) : vec2(world_pos.x, world_pos.y);

		vec2 cell_size = vec2(window_width + spacing_x, window_height + spacing_y);
		vec2 cell = floor(pos_2d / cell_size);
		vec2 f = fract(pos_2d / cell_size) - vec2(0.5);

		float size_x = window_width / cell_size.x;
		float size_y = window_height / cell_size.y;
		float is_window = step(abs(f.x), size_x * 0.5) * step(abs(f.y), size_y * 0.5);

		float rnd = fract(sin(dot(cell, vec2(127.1, 311.7))) * 43758.5453);
		float lit = step(1.0 - lit_chance, rnd);
		vec3 window_col = mix(glass_color, lit_color, lit * 0.75);
		albedo = mix(frame_color, window_col, is_window);
		emission = is_window * lit * lit_color * lit_strength;
		rough = mix(0.6, 0.15, is_window);
		metal = mix(0.2, 0.0, is_window);
	}

	ALBEDO = albedo;
	ROUGHNESS = rough;
	METALLIC = metal;
	EMISSION = emission;
}"

