[sub_resource type="Shader" id="floor_shader"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 tile_color : source_color = vec3(0.84, 0.82, 0.77);
uniform vec3 grout_color : source_color = vec3(0.62, 0.6, 0.56);
uniform float grout_width : hint_range(0.0, 0.1) = 0.02;
uniform float tile_roughness : hint_range(0.0, 1.0) = 0.5;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	vec2 tiles = UV * vec2(20.0, 15.0);
	vec2 cell = floor(tiles);
	vec2 f = fract(tiles) - 0.5;
	float grout_line = step(max(abs(f.x), abs(f.y)), grout_width);
	float variation = mix(0.97, 1.03, hash(cell));
	vec3 col = mix(tile_color * variation, grout_color, grout_line);
	ALBEDO = col;
	ROUGHNESS = mix(tile_roughness, 0.95, grout_line);
	METALLIC = 0.0;
}"

[sub_resource type="ShaderMaterial" id="floor_material"]
shader = SubResource("floor_shader")
shader_parameter/grout_width = 0.025

[sub_resource type="Shader" id="wood_shader"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 base_color : source_color = vec3(0.78, 0.58, 0.36);
uniform float roughness_base : hint_range(0.0, 1.0) = 0.55;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
	vec2 uv = UV * vec2(2.0, 8.0);
	float streaks = sin(uv.x * 5.0 + noise(vec2(uv.y * 2.0, 0.0)) * 2.0) * 0.5 + 0.5;
	float grain = noise(vec2(uv.y * 6.0, uv.x * 1.5));
	float shade = mix(0.9, 1.05, grain) * mix(0.93, 1.0, streaks);
	ALBEDO = base_color * shade;
	ROUGHNESS = clamp(roughness_base + grain * 0.18, 0.0, 1.0);
	METALLIC = 0.0;
}"

[sub_resource type="Shader" id="fabric_shader"]
code = "shader_type spatial;
render_mode diffuse_burley, specular_schlick_ggx;

uniform vec3 base_color : source_color = vec3(0.2, 0.45, 0.5);
uniform float roughness_base : hint_range(0.0, 1.0) = 0.9;
uniform float detail_scale : hint_range(1.0, 200.0) = 60.0;
uniform float variation : hint_range(0.0, 0.5) = 0.08;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
		mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment() {
	float n = noise(UV * detail_scale);
	float shade = 1.0 + (n - 0.5) * variation * 2.0;
	ALBEDO = base_color * shade;
	ROUGHNESS = clamp(roughness_base + (n - 0.5) * 0.2, 0.0, 1.0);
	METALLIC = 0.0;
}"

